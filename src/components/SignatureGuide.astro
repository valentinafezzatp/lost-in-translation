---
import { signatureGuide } from '../site.config';

const { pdf, preview, downloadName, verifyUrl, steps } = signatureGuide;

// Íconos de trazo simple, en el mismo idioma visual que la infografía
const icons = {
  download: 'M12 3v12m0 0-5-5m5 5 5-5M5 21h14',
  pen: 'M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z',
  clip: 'm21 11-8.5 8.5a5.5 5.5 0 0 1-7.8-7.8l8.5-8.5a3.7 3.7 0 0 1 5.2 5.2l-8.5 8.5a1.8 1.8 0 0 1-2.6-2.6L15 6.6',
};
---

<section id="firma-digital" class="section">
  <div class="container grid">
    <div>
      <div class="section-head">
        <span class="eyebrow">after delivery</span>
        <h2>Cómo ver tu traducción con <em>firma digital</em></h2>
        <p>
          Las traducciones públicas se entregan en un PDF legalizado y firmado digitalmente. Así podés abrirlo y
          comprobar que todo esté en orden:
        </p>
      </div>

      <ol class="timeline">
        {
          steps.map(({ icon, title, description }) => (
            <li>
              <span class="icon">
                <svg
                  viewBox="0 0 24 24"
                  width="22"
                  height="22"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d={icons[icon]} />
                </svg>
              </span>
              <div>
                <h3>{title}</h3>
                <p>{description}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <p class="verify">
        También podés verificar la legalización en el
        <a href={verifyUrl} target="_blank" rel="noopener">sitio del Colegio de Traductores Públicos (CTPCBA)</a>,
        cargando la traducción legalizada.
      </p>
    </div>

    <aside class="download" aria-label="Instructivo descargable">
      <a class="preview" href={pdf} target="_blank" rel="noopener">
        <img src={preview} alt="Vista previa del instructivo en PDF" width="636" height="900" loading="lazy" />
      </a>
      <a class="btn btn-primary" href={pdf} download={downloadName}>Descargar instructivo (PDF)</a>
    </aside>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    align-items: start;
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  .section-head {
    margin-bottom: 2.5rem;
  }

  /* Línea vertical que une los pasos, como en la infografía */
  .timeline {
    position: relative;
    display: grid;
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline::before {
    content: '';
    position: absolute;
    top: 1.5rem;
    bottom: 1.5rem;
    left: calc(1.5rem - 1px);
    border-left: 2px dashed var(--ink);
  }

  .timeline li {
    position: relative;
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1.25rem;
  }

  .icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--lime);
  }

  .timeline li:nth-child(2) .icon {
    background: var(--blush);
  }

  .timeline li:nth-child(3) .icon {
    background: var(--beige);
  }

  h3 {
    margin-bottom: 0.3rem;
    font-size: 1.4rem;
  }

  .timeline p {
    margin: 0;
  }

  .verify {
    margin-top: 2.5rem;
    padding: 1.25rem 1.5rem;
    background: var(--blush);
    border: 2px solid var(--ink);
    border-radius: var(--radius);
  }

  .verify a {
    font-weight: 700;
  }

  .download {
    position: sticky;
    top: 6rem;
    display: grid;
    justify-items: center;
    gap: 1.75rem;
  }

  .preview {
    display: block;
    max-width: 20rem;
    padding: 0.75rem;
    background: #fff;
    border: 2px solid var(--ink);
    box-shadow: var(--shadow);
    transform: rotate(2deg);
    transition: transform 0.2s;
  }

  .preview:hover {
    transform: rotate(0deg) scale(1.02);
  }

  .preview img {
    width: 100%;
    height: auto;
  }

  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .download {
      position: static;
    }

    .preview {
      max-width: 16rem;
    }
  }
</style>
