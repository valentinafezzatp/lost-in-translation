---
import { steps } from '../site.config';
---

<section id="como-trabajo" class="section process">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">step by step</span>
      <h2>Cómo <em>trabajo</em></h2>
    </div>

    <ol class="steps">
      {
        steps.map(({ title, description }, index) => (
          <li>
            <span class="badge">{index + 1}</span>
            <h3>{title}</h3>
            <p>{description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process {
    background: var(--pink);
    border-block: 2px solid var(--ink);
  }

  /* Sobre rosa, el acento magenta no contrasta: se usa la tinta */
  .process .eyebrow,
  .process h2 em {
    color: var(--ink);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    gap: 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .badge {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    margin-bottom: 1rem;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--lime);
    font-family: var(--font-display);
    font-size: 1.5rem;
  }

  p {
    margin: 0;
  }
</style>
