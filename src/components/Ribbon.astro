---
const words = [
  'inglés ⇄ español',
  'documentos personales',
  'documentos académicos',
  'jurídicos y técnicos',
  'revisión y corrección',
];
// Duplicado para que la animación sea un loop continuo
const loop = [...words, ...words];
---

<div class="wrap" aria-hidden="true">
  <div class="ribbon">
    <div class="track">
      {loop.map((word) => <span>{word} <i>✦</i></span>)}
    </div>
  </div>
</div>

<style>
  /* Recorta lo que la cinta sobresale a los costados. Safari iOS ignora el
     overflow-x del body y achica toda la página si algo se pasa de ancho. */
  .wrap {
    overflow-x: clip;
  }

  .ribbon {
    overflow: hidden;
    padding-block: 0.9rem;
    background: var(--ink);
    color: var(--lime);
    transform: rotate(-1.2deg);
    margin-inline: -1rem;
  }

  .track {
    display: flex;
    gap: 2rem;
    width: max-content;
    animation: scroll 30s linear infinite;
  }

  span {
    font-family: var(--font-display);
    font-size: 1.4rem;
    white-space: nowrap;
  }

  i {
    margin-left: 2rem;
    font-style: normal;
    color: var(--pink);
  }

  @keyframes scroll {
    to {
      transform: translateX(-50%);
    }
  }
</style>
