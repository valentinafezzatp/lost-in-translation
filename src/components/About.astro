---
import { about, site } from '../site.config';
---

<section id="sobre-mi" class="section about">
  <div class="container grid">
    <div class="frame gingham">
      <img src={about.photo} alt={`Foto de ${site.firstName}`} width="900" height="900" loading="lazy" />
      <span class="note">that's me!</span>
    </div>

    <div>
      <span class="eyebrow">nice to meet you</span>
      <h2>¡Hola, soy <em>{site.firstName}</em>!</h2>
      {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      <ul class="credentials">
        {about.credentials.map((credential) => <li class="pill">{credential}</li>)}
      </ul>
      <a class="btn btn-ghost ctpcba" href={about.ctpcbaUrl} target="_blank" rel="noopener">
        Ver mi perfil en el Colegio de Traductores Públicos <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--beige);
    border-block: 2px solid var(--ink);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    align-items: center;
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  .frame {
    position: relative;
    padding: 1.25rem;
    border: 2px solid var(--ink);
    border-radius: 50% 50% var(--radius) var(--radius);
    overflow: hidden;
  }

  /* La foto es cuadrada: se recorta a 4:5 priorizando la cara */
  .frame img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 20%;
    border-radius: 50% 50% 0.5rem 0.5rem;
  }

  .note {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    padding: 0.25rem 1rem;
    background: var(--cream);
    border: 2px solid var(--ink);
    border-radius: 999px;
    font-family: var(--font-hand);
    font-size: 1.5rem;
    transform: translateX(-50%) rotate(-4deg);
  }

  .credentials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .ctpcba {
    margin-top: 2rem;
    background: var(--cream);
  }

  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .frame {
      max-width: 20rem;
    }
  }
</style>
