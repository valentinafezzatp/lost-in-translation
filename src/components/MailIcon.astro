  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <rect x="2" y="4" width="20" height="16" rx="3"></rect>
  <path d="m3 7 9 6 9-6"></path>
</svg>
