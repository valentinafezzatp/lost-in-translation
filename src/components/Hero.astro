---
import { site } from '../site.config';
import { waLink } from '../lib/whatsapp';
---

<section class="hero">
  <div class="container grid">
    <div>
      <span class="eyebrow">hello there!</span>
      <h1>Que nada se <em>pierda</em> en la traducción.</h1>
      <p class="lead">
        Traducciones públicas inglés ⇄ español para que cada documento conserve su sentido y propósito en el
        idioma de destino.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href={waLink(site.whatsappMessage)} target="_blank" rel="noopener">
          Pedir presupuesto
        </a>
        <a class="btn btn-ghost" href="/#servicios">Ver servicios</a>
      </div>
    </div>

    <div class="visual">
      <div class="backdrop gingham" aria-hidden="true"></div>
      <figure class="polaroid">
        <img src="/logo.jpeg" alt={`Logo de ${site.name}`} width="500" height="500" />
        <figcaption>since {site.since} ♡</figcaption>
      </figure>
      <span class="sticker" aria-hidden="true">EN ⇄ ES</span>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    align-items: center;
    gap: clamp(2.5rem, 6vw, 5rem);
  }

  .lead {
    max-width: 34rem;
    font-size: 1.2rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .visual {
    position: relative;
    max-width: 24rem;
    justify-self: center;
    width: 100%;
  }

  .backdrop {
    position: absolute;
    inset: 8% -8% -6% 10%;
    border: 2px solid var(--ink);
    border-radius: var(--radius);
  }

  .polaroid {
    position: relative;
    margin: 0;
    padding: 0.9rem 0.9rem 0;
    background: #fff;
    border: 2px solid var(--ink);
    box-shadow: var(--shadow);
    transform: rotate(-3deg);
  }

  .polaroid img {
    width: 100%;
    height: auto;
  }

  figcaption {
    padding-block: 0.6rem 0.8rem;
    font-family: var(--font-hand);
    font-size: 1.75rem;
    text-align: center;
  }

  .sticker {
    position: absolute;
    top: -1.25rem;
    right: -1rem;
    display: grid;
    place-items: center;
    width: 6.5rem;
    height: 6.5rem;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--lime);
    font-family: var(--font-display);
    font-size: 1.15rem;
    transform: rotate(12deg);
  }

  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
    }

    .visual {
      max-width: 18rem;
      margin-right: 1.5rem;
    }
  }
</style>
