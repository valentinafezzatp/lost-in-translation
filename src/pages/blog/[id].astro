---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ContactCta from '../../components/ContactCta.astro';
import { formatDate } from '../../lib/format';
import { site } from '../../site.config';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, tag, instagram, cover } = post.data;
const { Content } = await render(post);
---

<Layout title={title} description={description} image={cover}>
  <article class="section">
    <div class="container narrow">
      <a class="back" href="/blog">← Volver al blog</a>
      <header>
        {tag && <span class="pill">{tag}</span>}
        <h1>{title}</h1>
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      </header>
      {
        cover && (
          <figure class="cover">
            <img src={cover.src} alt={cover.alt} width={cover.width} height={cover.height} />
          </figure>
        )
      }
      <div class="prose">
        <Content />
      </div>
      {
        instagram && (
          <aside class="instagram">
            <p>Este artículo nació como un carrusel en Instagram.</p>
            <a class="btn btn-primary" href={instagram} target="_blank" rel="noopener">
              Ver el post en Instagram <span aria-hidden="true">↗</span>
            </a>
            <p class="follow">
              Más contenido en{' '}
              <a href={site.instagram.url} target="_blank" rel="noopener">
                @{site.instagram.handle}
              </a>
            </p>
          </aside>
        )
      }
    </div>
  </article>
  <ContactCta />
</Layout>

<style>
  .narrow {
    max-width: 44rem;
  }

  .back {
    display: inline-block;
    margin-bottom: 2rem;
    font-weight: 500;
    text-decoration: none;
  }

  header {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 2px solid var(--ink);
  }

  h1 {
    margin-top: 1rem;
    font-size: clamp(2.25rem, 5vw, 3.5rem);
  }

  /* El HTML del markdown no lleva los atributos de scope de Astro */
  .prose :global(h2) {
    margin-top: 2.5rem;
    font-size: 2rem;
  }

  .prose :global(a) {
    color: var(--magenta);
  }

  .prose :global(blockquote) {
    margin: 2rem 0;
    padding: 1.25rem 1.5rem;
    background: var(--blush);
    border-left: 4px solid var(--magenta);
    border-radius: 0 var(--radius) var(--radius) 0;
  }

  .prose :global(blockquote p) {
    margin: 0;
  }

  .prose :global(code) {
    padding: 0.1rem 0.4rem;
    background: var(--beige);
    border-radius: 0.3rem;
  }

  /* Portada tipo polaroid, como en el hero */
  .cover {
    max-width: 26rem;
    margin: 0 auto 3rem;
    padding: 0.75rem;
    background: #fff;
    border: 2px solid var(--ink);
    box-shadow: var(--shadow);
    transform: rotate(-1.5deg);
  }

  .cover img {
    width: 100%;
    height: auto;
  }

  .instagram {
    display: grid;
    justify-items: start;
    gap: 1rem;
    margin-top: 3rem;
    padding: clamp(1.25rem, 4vw, 2rem);
    background: var(--lime);
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .instagram p {
    margin: 0;
  }

  .follow a {
    font-weight: 700;
  }
</style>
